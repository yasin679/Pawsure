# Pawsure API settings. Set these as environment variables on the host (the API does not read a .env file itself;
# locally you can run: node --env-file=.env ...). Never commit real values.
NODE_ENV=development
PORT=8787
# Leave unset for local PGlite (apps/api/.data/pglite). Production: managed PostgreSQL in an India region.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Required outside demo mode. Long random secret used to hash OTP codes.
OTP_PEPPER=
# Shared secret the scheduler sends (header x-job-secret) to POST /jobs/tick every minute.
JOB_SECRET=
# Encrypts code-card codes at rest (required in production). 32 random bytes, base64-encoded.
CODE_CARD_KEY=
# Shared secret every vendor webhook must send as x-webhook-secret. Required outside demo mode: webhooks are refused without it.
WEBHOOK_SECRET=
# Comma-separated allowed origins for the PWA in production.
WEB_ORIGIN=http://localhost:5173
# Demo mode: on by default in development. Set to 0 to disable demo routes, the demo clock and on-screen OTP codes.
DEMO_MODE=1
DEMO_START=2026-11-06T09:00:00+05:30
# Encrypted backups (PGlite deployments; managed Postgres uses provider PITR). 32 bytes as 64 hex characters.
BACKUP_DIR=backups
BACKUP_KEY=
# Vendor credentials — not connected yet (mock adapters). Add per vendor once contracts and template approvals exist.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
WA_BSP_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WEBHOOK_SECRET=
IVR_API_KEY=
IVR_NUMBER=
IVR_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LLM_API_KEY=
STORAGE_BUCKET=
STORAGE_KEY=
